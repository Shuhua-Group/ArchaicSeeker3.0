import sys
sys.path.insert(0, './')

import numpy as np
from utils.utils import *


configfile: "config/snakemake/config.yaml"

output_dir = config["output_dir"]
replicates = config["replicates"]

np.random.seed(config["seed"])

seed_list = np.random.random_integers(1,2**31,replicates)
demo_model_list = config["demo_models"]
nref_list = [10, 50]
ntgt_list = [1, 10]


rule all:
    input:
        expand(
            output_dir + "inference/ArchaicSeeker3.0/{demog}/nref_{nref}/ntgt_{ntgt}/{seed}/AS3_Transformer_Smoother_200_100_1000_4803_new.bed",
            demog=demo_model_list, nref=nref_list, ntgt=ntgt_list, seed=seed_list
        )

rule run_AS3_Transformer_Smoother_200_100_1000_4803:
    input:
        map_file = "/home/linhuanyu/83_AS3_SSTAR/sstar-analysis/config/ArchaicSeeker3.0/{demog}/nref_{nref}/ntgt_{ntgt}/reference_map.txt",
        ref_vcf = output_dir + "inference/ArchaicSeeker3.0/{demog}/nref_{nref}/ntgt_{ntgt}/{seed}/sim.ref.vcf.gz",
        tgt_vcf = output_dir + "inference/ArchaicSeeker3.0/{demog}/nref_{nref}/ntgt_{ntgt}/{seed}/sim.tgt.vcf.gz",
    output:
        intro_bed = output_dir + "inference/ArchaicSeeker3.0/{demog}/nref_{nref}/ntgt_{ntgt}/{seed}/AS3_Transformer_Smoother_200_100_1000_4803_new.bed",
    params:
        out_path = output_dir + "inference/ArchaicSeeker3.0/{demog}/nref_{nref}/ntgt_{ntgt}/{seed}",
        merge_distance = 4803,
    resources:
        gpu=1,
    shell:
        """
        export CUDA_VISIBLE_DEVICES=$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits | sort -nk2 | head -n1 | cut -d, -f1)

        mkdir -p {params.out_path}
        cd {params.out_path}

        rm -f introgression_prediction.bed mosaic_merged.bed

        module load ArchaicSeeker/3.0

        echo "👉 Running ArchaicSeeker3..." >> run.log
        /usr/bin/time -v ArchaicSeeker3 \
            -t {input.tgt_vcf} \
            -r {input.ref_vcf} \
            -m {input.map_file} \
            -o {params.out_path} \
            --merge {params.merge_distance} \
            1>> as3.stdout.log 2>> as3.stderr.log
        bcftools query -l {input.tgt_vcf} > tgt_samples.txt

        awk '{print 2*NR-2, $1 "_1"; print 2*NR-1, $1 "_2";}' tgt_samples.txt > hapmap.txt

        awk 'NR==FNR {{map[$1]=$2; next}} {{$4 = map[$4]; print}}' hapmap.txt introgression_prediction.bed > {output.intro_bed}
        """



